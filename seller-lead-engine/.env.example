# Copy to .env and fill in. Never commit .env.
# Settings that are not secrets (senders, states, caps) live in
# config/engine.config.json instead; start it with: npm run engine -- init

# Claude API: classifies owners' replies and pulls out the facts they state
# (revenue, timeline, motivation, readiness answers). Without it the engine
# still runs: the deterministic rules (bounces, opt-outs, auto-replies,
# complaints, "are you a bot?") work as always, and everything else falls
# back to keyword matching, which classifies but extracts no figures.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default claude-opus-5).
# AMB_CLAUDE_MODEL=

# Google Places API (New), used only by `score --places` for business status,
# rating count and website. Only the place_id is stored; details sit in a
# 30-day cache under data/cache/. Blank: `score` scores from public records
# alone, and `score --places` refuses with a message.
GOOGLE_PLACES_API_KEY=

# A ZeroBounce-compatible email verifier, used by `enrich`. Blank: every
# address ends "unknown", which is not sendable, so nothing goes out until a
# person checks each address with
#   npm run engine -- verify <prospectId> valid --by "<your name>"
EMAIL_VERIFIER_API_KEY=

# Gmail API tokens file, used only when sending.transport is "gmail_api"
# (send, sync and reply drafts). Format, from an Internal OAuth app in the
# sending Workspace tenant (a Testing-status external app expires refresh
# tokens after 7 days):
#   { "client_id": "...", "client_secret": "...",
#     "mailboxes": { "<mailbox>": { "refresh_token": "..." } } }
# Blank: .gmail-tokens.json in the project folder (git-ignored). With the
# default "outbox" transport this file is not needed.
GMAIL_TOKENS_FILE=.gmail-tokens.json

# Where the config and the data folder live. Blank:
# config/engine.config.json and data/ under the folder you run the engine
# from. Both are git-ignored: real prospect data never goes in git.
LEAD_ENGINE_CONFIG=config/engine.config.json
LEAD_ENGINE_DATA_DIR=data

# Sunbiz quarterly business file (download florida). The Division of
# Corporations publishes a public login for its SFTP server on
# https://dos.fl.gov/sunbiz/other-services/data-downloads/ : copy the user
# name and password from that page. Blank: the download skips Sunbiz and
# fetches the DBPR contractor files only.
SUNBIZ_SFTP_USER=
SUNBIZ_SFTP_PASSWORD=
