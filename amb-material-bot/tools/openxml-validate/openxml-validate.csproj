<Project Sdk="Microsoft.NET.Sdk">
  <!-- Open XML SDK validator: the closest offline stand-in for Microsoft Office's own file check.
       tests/model-ooxml.test.ts builds and runs it when `dotnet` is installed, and skips it otherwise. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>openxml-validate</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
