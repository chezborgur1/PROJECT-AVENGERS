# Copy to .env and fill in. Never commit .env.

# Claude API: reads tax returns, bank statements and PDF financials, transcribes
# intake notes into structured facts (when the folder has no intake.json), and
# drafts the CIM copy. Without it the bot still runs: PDFs and images are
# skipped with a warning, and the CIM copy comes from the folder's
# cim-copy.fixture.json (the sample has one) or is templated with
# [Confirm: ...] placeholders.
ANTHROPIC_API_KEY=

# QuickBooks Online (Intuit developer app, OAuth 2.0).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
# production | sandbox
QBO_ENVIRONMENT=production

# Where the request list lives and where deliverables are written. The live list
# is git-ignored (requests/live-*.csv); start it by copying the sample file.
AMB_REQUESTS_FILE=requests/live-requests.csv
AMB_OUTPUT_DIR=output

# Firm details: the name goes on the model, the contact fields on the CIM's
# contact block (a blank contact name prints as [Confirm: contact]).
AMB_FIRM_NAME=AMB Advisory Services
AMB_CONTACT_NAME=Frank
AMB_CONTACT_EMAIL=frank@ambadvisoryservices.com
AMB_CONTACT_PHONE=

# Optional: override the Claude model (default claude-opus-5).
# AMB_CLAUDE_MODEL=
# QuickBooks OAuth redirect URI registered on your Intuit app. Intuit's
# OAuth Playground URI works for connecting a company by hand:
QBO_REDIRECT_URI=https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl
