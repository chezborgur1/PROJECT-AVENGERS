{
  "name": "amb-material-bot",
  "version": "0.1.0",
  "private": true,
  "description": "AMB Advisory: turns a high-priority request list into a 3-statement model (.xlsx) and a 10-page CIM (.pptx) per business",
  "type": "module",
  "bin": {
    "amb-bot": "./src/cli.ts"
  },
  "scripts": {
    "bot": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts run --id REQ-0001 --force --no-update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
